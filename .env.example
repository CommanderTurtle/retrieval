# Chroma is an index, not the source of truth. The canonical content remains in
# the files and exports named by sources.toml. The client disables Chroma's
# anonymized telemetry in code.
RETRIEVAL_CHROMA_HOST=127.0.0.1
RETRIEVAL_CHROMA_PORT=8100
RETRIEVAL_CHROMA_SSL=false
RETRIEVAL_ARCHIVE_DB=~/.local/share/hermes-retrieval/archive.sqlite3

# Prefer an existing OpenAI-compatible embeddings endpoint when one is set.
# These names intentionally match Diogenes.
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=4000

# Optional: follow the URL and model saved by a Diogenes installation. Explicit
# EMBEDDING_* values above take precedence. Set EMBEDDING_API_KEY explicitly if
# the endpoint needs one; Diogenes stores its own key encrypted.
DIOGENES_ROOT=
DIOGENES_EMBEDDING_ENDPOINT_FILE=

# Local, zero-config fallback. This model and cache layout match Diogenes.
RETRIEVAL_FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_FASTEMBED_CACHE=~/.cache/fastembed

# Explicit project root used by sources.toml. No home-directory scan occurs.
HERMES_PROJECTS_DIR=~/Hermes
HERMES_COMMAND=hermes
HERMES_SESSION_NEWER_THAN=3650d

# MCP startup reconciles once, then the elected Linux/WSL inotify watcher
# refreshes only changed sources. Other platforms use cheap fingerprint polling.
# A host-wide writer lock prevents default/profile MCP processes from racing.
RETRIEVAL_WATCH_ENABLED=true
RETRIEVAL_WATCH_DEBOUNCE_MS=1500
RETRIEVAL_WATCH_POLL_SECONDS=15
RETRIEVAL_SYNC_LOCK=~/.local/share/hermes-retrieval/archive.sqlite3.sync.lock
RETRIEVAL_SYNC_LOCK_TIMEOUT=30
RETRIEVAL_SKILL_ARCHIVE=~/.local/share/hermes-retrieval/skill-archive

# Retrieval limits protect the active model context.
RETRIEVAL_MAX_SKILLS_PER_LOAD=6
RETRIEVAL_MAX_SKILL_CHARS=60000
RETRIEVAL_MAX_TOTAL_SKILL_CHARS=120000
RETRIEVAL_MAX_RECALL_CHARS=8000
