# Chroma is an index, not the source of truth. The canonical content remains in
# the files and exports named by sources.toml. The client disables Chroma's
# anonymized telemetry in code.
RETRIEVAL_CHROMA_HOST=127.0.0.1
RETRIEVAL_CHROMA_PORT=8100
RETRIEVAL_CHROMA_SSL=false
RETRIEVAL_ARCHIVE_DB=~/.local/share/retrieval/archive.sqlite3

# Prefer an existing OpenAI-compatible embeddings endpoint when one is set.
# These names intentionally match Diogenes.
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=4000

# Optional: follow the URL and model saved by a Diogenes installation. Explicit
# EMBEDDING_* values above take precedence. Set EMBEDDING_API_KEY explicitly if
# the endpoint needs one; Diogenes stores its own key encrypted.
DIOGENES_ROOT=
DIOGENES_EMBEDDING_ENDPOINT_FILE=

# Local, zero-config fallback. This model and cache layout match Diogenes.
RETRIEVAL_FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_FASTEMBED_CACHE=~/.cache/fastembed

# Explicit project root used by sources.toml. No home-directory scan occurs.
HERMES_PROJECTS_DIR=~/Hermes
HERMES_COMMAND=hermes
HERMES_SESSION_NEWER_THAN=3650d

# MCP startup reconciles once, then the elected Linux/WSL inotify watcher
# refreshes only changed sources. Other platforms use cheap fingerprint polling.
# A host-wide writer lock prevents default/profile MCP processes from racing.
RETRIEVAL_WATCH_ENABLED=true
RETRIEVAL_WATCH_DEBOUNCE_MS=1500
RETRIEVAL_WATCH_POLL_SECONDS=15
RETRIEVAL_SYNC_LOCK=~/.local/share/retrieval/archive.sqlite3.sync.lock
RETRIEVAL_SYNC_LOCK_TIMEOUT=30
RETRIEVAL_SKILL_INTAKE=~/Hermes/skill-library
RETRIEVAL_REFERENCE_ROOT=~/Hermes/reference-library

# IWE is a disposable, walkable Markdown graph over compact skill descriptors.
# Its maintainable upstream checkout is separate from both the generated graph
# and Retrieval's semantic Chroma index. Nothing here replaces Diogenes vectors.
RETRIEVAL_CATALOG_ROOT=~/.local/share/retrieval/catalog
RETRIEVAL_TAXONOMY_FILE=
RETRIEVAL_CATEGORY_OVERRIDES=
RETRIEVAL_PROJECTION_ROOT=~/.local/share/retrieval/projections
RETRIEVAL_IWE_COMMAND=~/.cargo/bin/iwe
RETRIEVAL_IWE_SOURCE=~/Hermes/iwe
RETRIEVAL_HERMES_CONFIG=~/.hermes/config.yaml
RETRIEVAL_OMP_CONFIG=~/.omp/agent/config.yml
RETRIEVAL_OMP_MCP_CONFIG=~/.omp/agent/mcp.json

# Do not put RETRIEVAL_HARNESS in this shared file. Integration injects
# `hermes` and `omp` into their respective MCP process environments, ensuring
# that each process can write only to its own projection lane.

# The selector is an ephemeral OMP RPC session with every built-in tool, skill,
# rule, and extension disabled. It receives only catalog_search/catalog_read.
RETRIEVAL_SCOUT_ENABLED=true
RETRIEVAL_OMP_COMMAND=~/.bun/bin/omp
RETRIEVAL_SCOUT_TIMEOUT=120
RETRIEVAL_SCOUT_MAX_CALLS=8
RETRIEVAL_SCOUT_PROFILE=retrieval-scout
RETRIEVAL_SCOUT_HOME=~/.local/share/retrieval/scout-home
RETRIEVAL_SCOUT_MODEL=

# Bound complete package copies without truncating the returned SKILL.md.
RETRIEVAL_PROJECTION_MAX_FILES=2000
RETRIEVAL_PROJECTION_MAX_BYTES=262144000

# Retrieval limits protect the active model context.
RETRIEVAL_MAX_SKILLS_PER_LOAD=6
RETRIEVAL_MAX_SKILL_CHARS=60000
RETRIEVAL_MAX_TOTAL_SKILL_CHARS=120000
RETRIEVAL_MAX_RECALL_CHARS=8000
